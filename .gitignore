# ==========================================
# Godot 4+ Specific Ignores
# ==========================================
.godot/
export_presets.cfg

# Chặn các file import riêng lẻ nếu bạn không muốn đưa lên
scenes/levels/imported/
assets/textures/triggers_imported/

# Chặn file UID của Godot (nếu bạn không muốn tracking uid hệ thống)
*.uid

# ==========================================
# Rust / GDExtension Builds (QUAN TRỌNG)
# ==========================================
rust/target/
rust/bin/
*.dll
*.so
*.dylib

# ==========================================
# IDEs & Editors
# ==========================================
.vscode/
*.kate-swp
.idea/


# Sau này nếu có file .txt hoặc .json rác từ Rust build, 
# hãy chặn đích danh thư mục chứa nó, đừng chặn toàn cục:
# rust/target/**/*.json

# ==========================================
# System Garbage (File rác của hệ điều hành)
# ==========================================
Thumbs.db
Desktop.ini
.DS_Store
*.tmp

# ==========================================
# Logs & General Backups
# ==========================================
*.log
*~
*.swp
*.swo
.history/
